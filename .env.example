# cwl-idp bring-up environment — BOOTSTRAP TRANSPORT ONLY.
#
# These values are injected from your platform secret manager (KV) at deploy
# time. They exist only to hand secrets to the container at start; the running
# services do not scatter os.getenv calls for real config — the admin service
# reads everything from the KV/DB config store (see deploy/bootstrap/).
#
#   cp .env.example .env    # then populate from KV, never commit .env

# ---- PostgreSQL (ZITADEL system of record) ----
IDP_DB_NAME=zitadel
IDP_DB_SUPERUSER=zitadel
IDP_DB_SUPERUSER_PASSWORD=            # from KV: secret/idp/db-superuser
IDP_DB_APP_USER=zitadel
IDP_DB_APP_PASSWORD=                  # from KV: secret/idp/db-app

# ---- ZITADEL engine ----
# 32-byte master key encrypting secrets at rest. Generate: openssl rand -base64 32 | cut -c1-32
IDP_MASTERKEY=                        # from KV: secret/idp/masterkey
IDP_EXTERNAL_DOMAIN=localhost
IDP_EXTERNAL_PORT=8080
IDP_EXTERNAL_SECURE=false
IDP_TLS_MODE=disabled                 # 'disabled' for local; 'external' behind the WAF

# Bootstrap admin (retires its password after registering a passkey).
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_USERNAME=idp-admin
ZITADEL_FIRSTINSTANCE_ORG_HUMAN_PASSWORD=   # from KV: secret/idp/bootstrap-admin

# ---- account-unification admin service ----
UNIFICATION_PORT=8099
